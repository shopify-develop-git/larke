{{ 'dev-brand-social-gallery.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  No JS of our own: Brief → Interactivity: none. Static badge + 4-image gallery grid.

  The grid has two modes and the geometry is identical in both:
    1. gallery_image blocks — four merchant-picked photos (the original design).
    2. an @app block — the LIVE feed from "Instafeed - Instagram Feed" (Mintt Studio),
       a Shopify 2.0 theme app extension that renders into its own #insta-feed element.
  Either way the children sit inside .brand-social-gallery__grid, so the 2px gap,
  overflow:hidden and 32px radius still fuse them into ONE rounded slab.

  App blocks render inline in the page DOM (no iframe), so this theme's stylesheet can
  reach #insta-feed directly — the app's own "Custom HTML code" box is only needed as a
  last resort if the app ever ships higher-specificity styles of its own.
{%- endcomment -%}

{%- comment -%} Fixed design tokens from Figma — not merchant-controlled {%- endcomment -%}
<style>
  .brand-social-gallery {

    {%- comment -%} No --container-max: Brief note #1 — no centred max-width frame exists in this
       node, exactly as for dev-site-header. The desktop inset comes entirely from
       --section-px, and on mobile the grid is genuinely edge-to-edge (Brief note #2),
       so the horizontal padding lives on __inner and drops to 0 at ≤768px. {%- endcomment -%}
    --section-px: 64px;
    --section-px-mobile: 0px;

    {%- comment -%} Mobile artboard specifies its own top spacer (48px), not a scale factor. {%- endcomment -%}
    --pt-mobile: 48px;

    --font-heading-size: 32px;
    --font-heading-size-mobile: 24px;
    --font-heading-weight: 500;
    --font-heading-lh: 1.2;
    --font-body-size: 16px;
    --font-body-size-mobile: 14px;
    --font-body-weight: 500;
    --font-body-lh: 1.4;

    --spacing-sm: 2px;   {%- comment -%} gap between grid tiles (both breakpoints) {%- endcomment -%}
    --spacing-md: 16px;  {%- comment -%} gap inside the text column {%- endcomment -%}
    --spacing-lg: 32px;  {%- comment -%} gap between the text column and the grid {%- endcomment -%}
    --spacing-md-mobile: 8px;
    --spacing-lg-mobile: 16px;

    {%- comment -%} Rounded on desktop, square on mobile — the mobile Grid node carries no
       corner-radius class because it is full-bleed (Brief note #2). {%- endcomment -%}
    --radius-gallery: 32px;
    --radius-gallery-mobile: 0px;

    --social-text-w: 327px;
    --social-handle-w-mobile: 122px;

    {%- comment -%} The grid's own width on the 1440 artboard: 1312 (inner) - 327 (text col) - 32 (gap) = 953.
       Read off the artboard, not invented. Once the row stacks (see the ≤1200 block in the CSS)
       the grid would otherwise span the full inner width and the tiles would balloon PAST their
       designed size; capping it here keeps them at the artboard's ~236px across the stack. {%- endcomment -%}
    --social-grid-w: 953px;

    {%- comment -%} Profile badge: a single full 58px circle — ring and content are one image,
       no longer split into a ring layer + inset mark. {%- endcomment -%}
    --badge-size: 58px;

    {%- comment -%} --- Instafeed app-block tokens -----------------------------------------------
       Consumed by dev-brand-social-gallery.css. THE NAMES ARE A CONTRACT — the CSS
       owns the rules, this file owns the numbers; renaming one silently drops a rule.

       Why a min-height exists at all: Instafeed fetches and injects its posts
       CLIENT-SIDE (the item markup is NOT in the server HTML). Between first paint
       and the app's 'instafeedAppLoaded' event, #insta-feed is an EMPTY element
       inside a flex row with nothing to give it height, so the 32px slab collapses
       to 0 and then pops open — a full-width layout shift on every cold load.
       Reserving exactly the height the four static tiles occupied makes the swap
       cost nothing. {%- endcomment -%}

    {%- comment -%} Identical derivation to .brand-social-gallery__tile: 4 across the 953px grid
       with three 2px gaps → (953 - 3×2) / 4 = 236.75. Floored to 236 so the
       reservation can never exceed what finally renders — over-reserving leaves a
       dead strip inside the slab, under-reserving costs at most 0.75px. {%- endcomment -%}
    --app-tile-min-h: 236px;

    {%- comment -%} Mobile 2-up on the 375 artboard, one 2px gap → (375 - 2) / 2 = 186.5, floored
       for the same reason. Same number as the ≤768px tile (Brief note #4's 186.5px
       belongs HERE, on mobile — never on desktop). {%- endcomment -%}
    --app-tile-min-h-mobile: 186px;

    {%- comment -%} Column counts, so the CSS can size the app's own items without re-deriving the
       artboard: 4 across at 1440, 2 across at 375 — matching the static tiles. {%- endcomment -%}
    --app-cols: 4;
    --app-cols-mobile: 2;
  }
</style>

{%- liquid
  assign badge_image = section.settings.profile_badge_logo
  assign badge_src = badge_image | image_url: width: 174
-%}

<div
  class="brand-social-gallery"
  style="
    --bg: {{ section.settings.background_color }};
    --color: {{ section.settings.text_color }};
    --accent: {{ section.settings.accent_color }};
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="brand-social-gallery__inner">
    <div class="brand-social-gallery__intro">
      {%- comment -%} Figma order in the text column: heading → badge → handle. {%- endcomment -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="brand-social-gallery__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- comment -%}
        Profile badge — Instagram-style: a green "Larke" disc inside a 2px gradient
        ring (magenta #D810A2 top → gold #FFBE2F bottom, with a small cream gap),
        sitting BETWEEN the heading and the handle. Merchant image wins; when unset
        we fall back to the vector exported from Figma
        (.figma-assets/brand-social-gallery/ — ring + disc + wordmark), which bakes
        the ring, green disc and white wordmark into one 58×58 SVG.
      {%- endcomment -%}
      <div class="brand-social-gallery__badge" aria-hidden="true">
        {%- if badge_image != blank -%}
          {{
            badge_src
            | image_tag:
              loading: 'lazy',
              widths: '58, 116, 174',
              sizes: '58px',
              alt: '',
              class: 'brand-social-gallery__badge-img'
          }}
        {%- else -%}
          <svg class="brand-social-gallery__badge-img" width="58" height="58" viewBox="0 0 58 58" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true">
            <circle cx="29" cy="29" r="28" stroke="url(#bsg-badge-ring)" stroke-width="2"/>
            <g transform="translate(5 5)">
              <circle cx="24" cy="24" r="24" fill="#4EA448"/>
              <g fill="white">
                <path d="M42.7619 27.1092H43C42.4973 28.8024 41.3861 29.8475 39.4415 29.8475C37.2985 29.8475 35.4598 28.6172 35.4598 26.3948C35.4598 24.1592 37.3382 22.929 39.3093 22.929C41.439 22.929 42.6693 24.2253 42.6957 25.7069H37.5895C37.5763 25.8789 37.5763 26.0509 37.5763 26.2361C37.5763 27.9293 38.4097 29.3448 40.0633 29.3448C41.2274 29.3448 42.246 28.6569 42.7619 27.1092ZM39.2828 23.22C38.3965 23.22 37.7747 23.9475 37.616 25.4159H40.6586C40.6586 24.0931 40.2485 23.22 39.2828 23.22Z"/>
                <path d="M34.4433 28.1409C34.9195 28.8023 35.1841 29.1595 35.5677 29.5828H33.1866C33.0014 29.0669 32.8427 28.7891 32.3797 28.1409C31.6521 27.0826 30.8848 26.5667 29.5885 26.4476C29.5752 26.6064 29.5752 26.7651 29.5752 26.9239C29.5752 27.7705 29.5885 28.4716 29.7207 29.5828H27.5116C27.6439 28.3922 27.6439 27.6779 27.6439 26.7519V21.8309C27.6439 20.9049 27.6439 20.1906 27.5116 19H29.7207C29.5752 20.1906 29.5752 20.9049 29.5752 21.8309V25.2703C29.9721 23.7755 30.9774 22.9289 32.5384 22.9289C33.5967 22.9289 34.4036 23.4051 34.4036 24.4501C34.4036 25.7994 32.803 26.2889 30.8452 26.3947C32.8823 26.6196 33.7422 27.162 34.4433 28.1409ZM31.6653 23.4448C30.607 23.4448 29.7737 24.3708 29.6017 26.2492C31.4404 26.2492 32.5913 25.6672 32.5913 24.4501C32.5913 23.8284 32.2474 23.4448 31.6653 23.4448Z"/>
                <path d="M26.8514 23.1933C26.9836 23.8944 26.6794 24.3971 26.0576 24.3971C25.9254 24.3971 25.7798 24.3707 25.6079 24.3178C25.4095 24.2516 25.2243 24.2119 25.0523 24.2119C24.5628 24.2119 24.0469 24.5162 23.1209 25.5348V26.8841C23.1209 27.8101 23.1209 28.445 23.2664 29.5827H21.0573C21.1896 28.445 21.1896 27.8101 21.1896 26.8841V25.8919C21.1896 24.966 21.1896 24.331 21.0573 23.1933H23.2664C23.1606 23.987 23.1342 24.5426 23.1209 25.1247C23.994 24.0532 24.7613 23.1272 26.1635 23.1272C26.3884 23.1272 26.6132 23.1537 26.8514 23.1933Z"/>
                <path d="M12.8316 28.0748C12.8316 26.4345 14.7365 26.0244 16.0065 25.7995C17.1573 25.5879 17.7394 25.3233 17.7394 24.4767C17.7394 23.6433 17.369 23.22 16.6547 23.22C15.5038 23.22 15.1863 24.0137 14.8027 24.5031C14.5778 24.7942 14.2735 24.9397 13.9693 24.9397C13.5592 24.9397 13.1888 24.6619 13.083 24.1063C13.9957 23.4978 15.3847 22.929 16.9192 22.929C18.5066 22.929 19.6575 23.4449 19.6707 25.0058V26.8314C19.6707 27.8103 19.6707 28.4452 19.8692 29.5829H17.8849C17.7923 29.067 17.7658 28.6966 17.7526 28.2336C17.3954 29.186 16.5753 29.8475 15.1334 29.8475C14.0354 29.8475 12.8316 29.3712 12.8316 28.0748ZM14.9482 27.7573C14.9482 28.7495 15.4112 29.1993 16.0858 29.1993C17.1044 29.1993 17.7394 28.2468 17.7394 27.0033V25.3762C17.488 25.6937 17.025 25.8128 16.4033 25.998C15.4244 26.289 14.9482 26.8578 14.9482 27.7573Z"/>
                <path d="M5.02646 19H7.53987C7.43404 20.0054 7.39436 20.6006 7.39436 21.8309V29.305H8.33358C9.70934 29.305 10.503 29.2124 12.2624 28.551L11.773 29.5828H5C5.11906 28.5774 5.17197 27.9821 5.17197 26.7519V21.8309C5.17197 20.6006 5.13228 20.0054 5.02646 19Z"/>
              </g>
            </g>
            <defs>
              <linearGradient id="bsg-badge-ring" x1="29" y1="0" x2="29" y2="58" gradientUnits="userSpaceOnUse">
                <stop stop-color="#D810A2"/>
                <stop offset="1" stop-color="#FFBE2F"/>
              </linearGradient>
            </defs>
          </svg>
        {%- endif -%}
      </div>

      {%- if section.settings.social_handle != blank -%}
        <p class="brand-social-gallery__handle">
          {%- if section.settings.social_handle_link != blank -%}
            <a
              class="brand-social-gallery__handle-link"
              href="{{ section.settings.social_handle_link }}"
              target="_blank"
              rel="noopener"
            >{{ section.settings.social_handle | escape }}</a>
          {%- else -%}
            {{ section.settings.social_handle | escape }}
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>

    {%- comment -%}
      "Is one of these blocks the Instagram feed?" has to be answered BEFORE the render
      loop starts, because block #1 (a photo) needs to know about block #5 (the feed) in
      order to decide whether to draw itself — and by the time the loop reaches #5 it has
      already emitted #1. Liquid has no `any?` predicate, so the boolean has to be built by
      walking the blocks once, up front, before a single tile is printed. `break` leaves the
      loop the moment it finds the feed.
    {%- endcomment -%}
    {%- liquid
      assign has_app_block = false
      for block in section.blocks
        if block.type == '@app'
          assign has_app_block = true
          break
        endif
      endfor

      assign hide_static_images = false
      if has_app_block and section.settings.hide_static_when_app
        assign hide_static_images = true
      endif
    -%}

    {%- if section.blocks.size > 0 -%}
      <div class="brand-social-gallery__grid">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'gallery_image' -%}
              {%- comment -%}
                Unchanged from the static design. Skipped — not deleted — once the live
                feed is in place and the merchant has left `hide_static_when_app` on, so
                the four photos survive in the editor as a fallback if the app is removed.
              {%- endcomment -%}
              {%- unless hide_static_images -%}
                <figure class="brand-social-gallery__tile" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- liquid
                      assign tile_src = block.settings.image | image_url: width: 800
                      assign tile_alt = block.settings.alt | default: block.settings.image.alt | escape
                    -%}
                    {{
                      tile_src
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400, 600, 800',
                        sizes: '(min-width: 769px) 20vw, 50vw',
                        alt: tile_alt,
                        class: 'brand-social-gallery__image'
                    }}
                  {%- endif -%}
                </figure>
              {%- endunless -%}

            {%- when '@app' -%}
              {%- comment -%}
                The Instafeed app block. A bare `render block` is the ONLY supported way to
                output one — `block` here is not a snippet name and takes no arguments.

                The wrapper exists so the theme has a stable hook of its own: the app owns
                everything from #insta-feed down, and we own .brand-social-gallery__app.
                It is what carries --app-tile-min-h (see the token block above) and what
                the CSS uses to force whatever the app renders back onto our 4-up / 2-up,
                2px-gap geometry so the feed lands inside the same rounded slab.

                UNVERIFIED, and it must stay that way in the comments until someone checks:
                the app injects post markup client-side, so its per-item class names could
                not be inspected. The two anchors that CANNOT rot are the documented
                container id `#insta-feed` and the fact that every post links to
                instagram.com (a[href*="instagram.com"]); anything more specific than those
                is a guess and is labelled as one in the CSS. To verify: load the page,
                wait for the document event 'instafeedAppLoaded', then inspect the children
                of #insta-feed and record the real class names here.
              {%- endcomment -%}
              <div class="brand-social-gallery__app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  Schema notes — they live OUT here because the schema block below must stay strictly valid
  JSON (no comments, no trailing commas), so there is nowhere inside it to explain itself.

  1. "blocks" now contains { "type": "@app" }. Shopify only offers app blocks in the theme
     editor for a section whose schema declares @app; without that line the Instafeed block
     simply never appears in the "Add block" list. "gallery_image" is untouched.

  2. "max_blocks" went 4 → 5 ON PURPOSE. DO NOT PUT IT BACK. An app block counts against the
     same budget as the photos, so at 4 the preset's four gallery_image blocks fill the section
     completely and the merchant physically cannot add the feed — the block limit locks out the
     very thing this section now exists to host. 5 is the exact ceiling needed: 4 photos + 1
     feed. It is not "room for a fifth photo" — gallery_image keeps its own "limit": 4.

  3. The preset still ships four gallery_image blocks and no app block: app blocks cannot be
     declared in a preset, so the merchant adds the Instafeed block by hand in the editor. The
     photos are what a freshly-added section shows until they do, which is also why
     hide_static_when_app defaults to true — the swap then happens the moment the app arrives.
{%- endcomment -%}
{% schema %}
{
  "name": "Brand social gallery",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Larke, lived in." },
    { "type": "text", "id": "social_handle", "label": "Social handle", "default": "@wearelarke.com" },
    {
      "type": "url",
      "id": "social_handle_link",
      "label": "Social handle link",
      "info": "Wraps the handle in a link (opens in a new tab) when set."
    },
    {
      "type": "image_picker",
      "id": "profile_badge_logo",
      "label": "Profile badge",
      "info": "58×58 circle — the whole badge is one image. Falls back to the Figma vector when empty."
    },

    { "type": "header", "content": "Instagram feed" },
    {
      "type": "checkbox",
      "id": "hide_static_when_app",
      "label": "Hide static images when the Instagram feed block is present",
      "default": true,
      "info": "Add the Instafeed app block to this section to show the live feed. Leave this on and the four gallery images stay saved but hidden, so removing the app brings them straight back."
    },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFCF4" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#333333" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#4EA448" },

    { "type": "header", "content": "Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "The Figma node has no bottom spacer — the next section's top spacer creates the gap."
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "info": "Describes the photo for screen readers." }
      ]
    },
    { "type": "@app" }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Brand social gallery",
      "blocks": [
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" },
        { "type": "gallery_image" }
      ]
    }
  ]
}
{% endschema %}
