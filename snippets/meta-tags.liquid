{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'

    comment
      Blog posts. Shopify's page_description for an article is, in order: the SEO description,
      the excerpt, then the BODY — and the body fallback is raw: 320 characters cut mid-word
      ("…With a feather aller") and carrying the editor's shortcodes ([tip], [icon:wash-40]).
      So when neither the SEO description nor the excerpt is set, the description is rebuilt:
        1. the post's Subtitle (custom.subtitle) — written by a person, the right length
        2. otherwise the cleaned body, cut at a word boundary (snippets/dev-article-plain-text)
      A description typed into "Search engine listing" or the excerpt still always wins.
    endcomment
    assign seo_description = article.metafields.global.description_tag.value | default: article.metafields.global.description_tag
    if seo_description == blank and article.excerpt == blank
      assign subtitle = article.metafields.custom.subtitle.value
      if subtitle != blank
        assign og_description = subtitle
      else
        capture og_description
          render 'dev-article-plain-text', html: article.content, words: 26
        endcapture
      endif
    endif
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'article' and article -%}
  {%- comment -%}
    Open Graph article properties: dates, author, section and tags on the share card. The author
    is the same chain the page byline uses — the Author profile, then custom.author, then the
    staff account — so a card never credits someone the article does not.
  {%- endcomment -%}
  {%- liquid
    assign og_author = article.metafields.custom.author_profile.value.name.value
    if og_author == blank
      capture og_author
        render 'dev-article-author', article: article
      endcapture
    endif
  -%}
  <meta
    property="article:published_time"
    content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}"
  >
  <meta
    property="article:modified_time"
    content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' }}"
  >
  {%- if og_author != blank -%}
    <meta
      property="article:author"
      content="{{ og_author | strip | escape }}"
    >
  {%- endif -%}
  {%- if article.tags.size > 0 -%}
    <meta
      property="article:section"
      content="{{ article.tags.first | escape }}"
    >
    {%- for tag in article.tags -%}
      <meta
        property="article:tag"
        content="{{ tag | escape }}"
      >
    {%- endfor -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  The blog's component library (templates/page.article-components.json) is a tool for the team,
  not content. Kept out of search here rather than trusting someone to set seo.hidden on the page.
{%- endcomment -%}
{%- if template.name == 'page' and template.suffix == 'article-components' -%}
  <meta
    name="robots"
    content="noindex, follow"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- comment -%}
  Falls back the same way og:description already does (page → shop → shop name), rather than
  emitting nothing. /cart, /pages/about and /pages/faq carry no description in the admin, so the
  guarded version shipped those pages with no <meta name="description"> at all — an SEO audit
  failure on every template except the homepage and the PDP.

  og_description is reused deliberately: one fallback chain, so the description a crawler reads
  and the one a social card shows can never drift apart. Setting a real per-page description in
  the admin still wins — this is the floor, not a substitute.
{%- endcomment -%}
<meta
  name="description"
  content="{{ og_description | escape }}"
>
