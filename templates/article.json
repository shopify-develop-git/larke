/*
 * Horizon's stock `main-blog-post` is replaced by our own dev-article section. The stock one
 * renders a system-font heading on a white page with a square full-bleed image and matches
 * nothing else in the theme. Project rule: custom dev-* sections only — stock sections are
 * never used or edited. Original stock config: git history of this file.
 */
{
  "sections": {
    "dev-article": {
      "type": "dev-article",
      "settings": {
        "show_breadcrumb": true,
        "breadcrumb_label": "Breadcrumb",
        "toc_label": "In this article",
        "back_label": "",
        "read_time_label": "min read",
        "author_prefix": "By",
        "show_date": true,
        "background_color": "rgba(0,0,0,0)",
        "text_color": "#333333",
        "meta_color": "#666666",
        "badge_color": "#FCF5E3",
        "rule_color": "#C4BCA9",
        "panel_color": "#FCF5E3",
        "tile_color": "#FFFCF4",
        "accent_color": "#A8CF78",
        "padding_top": 48,
        "padding_bottom": 48,
        "blog_crumb_label": "Snooze",
        "blog_crumb_link": "/pages/our-story#journal"
      }
    },
    "dev-article-author": {
      "type": "dev-article-author",
      "settings": {
        "label": "About the author",
        "show_rule": true,
        "background_color": "rgba(0,0,0,0)",
        "text_color": "#333333",
        "meta_color": "#666666",
        "panel_color": "#FCF5E3",
        "rule_color": "#C4BCA9",
        "padding_top": 0,
        "padding_bottom": 48
      }
    },
    "dev-article-related": {
      "type": "dev-article-related",
      "settings": {
        "heading": "Related articles",
        "limit": 3,
        "card_label": "Read Article",
        "read_time_label": "min read",
        "author_prefix": "By",
        "button_label": "All Articles",
        "background_color": "rgba(0,0,0,0)",
        "text_color": "#333333",
        "padding_top": 0,
        "padding_bottom": 64,
        "button_link": "/pages/our-story#journal"
      }
    },
    "dev-article-cta": {
      "type": "dev-article-cta",
      "settings": {
        "heading": "Meet the real thing.",
        "text": "Made from trees.\nEverything you love, made remarkable.",
        "button_label": "Our Duvet",
        "button_link": "shopify://products/natural-duvet",
        "background_color": "rgba(0,0,0,0)",
        "text_color": "#333333",
        "panel_color": "#FCF5E3",
        "padding_top": 0,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "dev-article",
    "dev-article-author",
    "dev-article-cta",
    "dev-article-related"
  ]
}
